	    "DB616".FillingInputPara[1].ProductionSetting.LoopDelay1 := "DB624".FillRinseSamplingLineDelay;
	    "DB616".FillingInputPara[1].ProductionSetting.LoopDelay2 := "DB624".FillRinseBlanketingLineDelay;
	    "DB616".FillingInputPara[1].ProductionSetting.LoopDelay3 := "DB624".FillRinseJTubeLineDelay;
	    "DB616".FillingInputPara[1].ProductionSetting.LoopDelay4 := "DB624".FillRinseSpargingLineDelay;
	    "DB616".FillingInputPara[1].ProductionSetting.LoopDelay5 := "DB624".FillRinseSbiLineDelay;
	    "DB616".FillingInputPara[1].ProductionSetting.LoopDelay6 := "DB624".FillRinseRecirculationlineDelay;
	    "DB616".FillingInputPara[1].ProductionSetting.LoopDelay7 := "DB624".FillRinseVesselBypassLineDelay;
	    "DB616".FillingInputPara[1].ProductionSetting.LoopDelay8 := "DB624".FillRinsePumpBypassLineDelay;
	    "DB616".FillingInputPara[1].ProductionSetting.LoopDelay9 := "DB624".FillRinsePf01InLineDelay;
	    "DB616".FillingInputPara[1].ProductionSetting.LoopDelay10 := "DB624".FillRinsePf01VentLineDelay;
	    "DB616".FillingInputPara[1].ProductionSetting.LoopDelay11 := "DB624".FillRinsePf02InLineDelay;
	    "DB616".FillingInputPara[1].ProductionSetting.LoopDelay12 := "DB624".FillRinsePf02VentLineDelay;
	    "DB616".FillingInputPara[1].ProductionSetting.LoopDelay13 := "DB624".FillRinsePf02OutLineDelay;
	    "DB616".FillingInputPara[1].ProductionSetting.LoopDelay14 := "DB624".FillRinsePf01BypassLineDelay;
	    "DB616".FillingInputPara[1].ProductionSetting.LoopDelay15 := "DB624".FillRinsePf02BypassLineDelay;
	    "DB616".FillingInputPara[1].ProductionSetting.LoopDelay16 := "DB624".FillRinsePtlLineDelay;
	    
	    
	    // "DB616".AirPurgingInputPara[1].ProductionSetting.LoopDelay1 := "DB624".AirPurgeSamplingLineDelay;
	    // "DB616".AirPurgingInputPara[1].ProductionSetting.LoopDelay2 := "DB624".AirPurgeBlankeingLineDelay;
