FUNCTION "FC615" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1

BEGIN
	REGION Common
	    IF "DB615".SelectStep = TRUE THEN
	        "DB615".TempStep := "DB615".CurrentStep;
	        REPEAT
	        "DB615".TempStep := "DB615".TempStep + 1;
	        UNTIL "DB623".StepEnable["DB615".TempStep] = TRUE OR ("DB615".TempStep > "DB616".TotalStep) END_REPEAT;
	        IF "DB615".TempStep <= "DB616".TotalStep THEN
	            "DB615".CurrentStep := "DB615".TempStep;
	        ELSE
	            "DB615".ProcessOver := 1;
	        END_IF;         
	        "DB615".SelectStep := false;
	    END_IF;
	    
	    
	    
	    IF "DB622".MainPopupMsg2 = 1 THEN
	        POKE_BLK(area_src := 16#84,
	                 dbNumber_src := 626,
	                 byteOffset_src := 0,
	                 area_dest := 16#84,
	                 dbNumber_dest := 625,
	                 byteOffset_dest := 0,
	                 count := 2382);  
	    END_IF;
	    
	END_REGION
	
	REGION common Set Para
	    "DB603".CycleSelection := "DB616".CycleSelection["DB615".CurrentStep];
	    
	    "DB604".ParaIn := "DB616".FillingInputPara["DB615".CurrentStep];
	    "DB607".SetTimeSecs := "DB616".MixingTimeInput["DB615".CurrentStep];
	    "DB608".ParaIn := "DB616".RecirculationInput["DB615".CurrentStep];
	    "DB609".ParaIn := "DB616".DrainInputs["DB615".CurrentStep];
	    "DB610".SetTime := "DB616".SystemDrainSetTimeInput["DB615".CurrentStep];
	    "DB611".ParaIn := "DB616".AirPurgingInputPara["DB615".CurrentStep];
	    "DB603".CycleSelection := "DB616".CycleSelection["DB615".CurrentStep];
	    
	    "DB609".ActualPressure := "AiDb".Ai11.ActValue;
	    "DB627".RepSv := "DB616".CycleSelection["DB615".CurrentStep].StepSelection.SetRepetition;
	    "DB627".RepPv := "DB603".ActualRepetition;
	    "DB604".ActualQuantity := "ModeDb".VesselWeight;
	    "DB609".ActualWeight := "ModeDb".VesselWeight;
	  //  "DB611".ActualPressure := "AiDb".Ai07.ActValue;
	    "DB609".ActualConductivityVessel := "AiDb".Ai15.ActValue;
	    "DB609".ParaIn.Parameters.SetConductivity := "DB623".FinalRinseSetCond;
	    "DB611".ActualPressure := "DB615".ApActPressure;
	    
	
	    "DB616".DrainInputs["DB615".CurrentStep].PreciseEngineering.DrainWeight := "DB624".VesselDrainWeight;
	    "DB616".DrainInputs["DB615".CurrentStep].Parameters.SetPressure := "DB623".DrainPressure;
	    "DB616".DrainInputs["DB615".CurrentStep].Parameters.PressureTolerance := "DB624".DrainPressureTolerance;
	    "DB616".DrainInputs["DB615".CurrentStep].ProductionSetting.CaiDelay := "CommonProductionSettings".CAIDelay;
	    
	    "DB616".SystemDrainSetTimeInput["DB615".CurrentStep] := "DB623".SystemDrainTime;
	    
	    "DB616".AirPurgingInputPara["DB615".CurrentStep].Parameters.SetPressure := "DB623".AirPurgingPressure;
	    "DB616".AirPurgingInputPara["DB615".CurrentStep].Parameters.PressureTolerance := "DB624".AirPurgingPressureTolerence;
	    "DB616".AirPurgingInputPara["DB615".CurrentStep].Parameters.VentOnTime := "DB624".AirPurgingReleaseTime;
	    "DB616".AirPurgingInputPara["DB615".CurrentStep].ProductionSetting.CAIDelay := "CommonProductionSettings".CAIDelay;
	    
	    
	    IF "DB611".StepDelay."Noof StepsPv" <= 1 THEN
	        "DB616".AirPurgingInputPara["DB615".CurrentStep].Selections.PressureMode := 0;
	    ELSE
	        "DB616".AirPurgingInputPara["DB615".CurrentStep].Selections.PressureMode := 1;
	    END_IF;
	    
	    "DB616".AirPurgingInputPara["DB615".CurrentStep].ProductionSetting.LoopDelay1 := "DB624".AirPurgeSamplingLineDelay;
