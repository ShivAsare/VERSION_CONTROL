	    REGION RECIRCULATION
	        IF "DB615".CurrentStep = 2 THEN
	            "DB616".RecirculationOutput[2] := "DB608".ParaOut;
	            //"DB625".RecirculationPrint[2] := "DB608".Print;
	        ELSE
	            "DB616".RecirculationOutput[2] := "DB616".RecirculationOutput[0];
	        END_IF;
