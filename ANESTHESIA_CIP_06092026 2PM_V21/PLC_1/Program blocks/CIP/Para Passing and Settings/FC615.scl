	    "DB616".RecirculationInput[3].Parameters.LoopDelay5 := "DB624".RecSbiLineDelay;
	    
	    //"DB616".DrainInputs[3].ProductionSetting.LoopDelay1 := "DB624".FinalRinseCycleVesselDrainLineDelay;
