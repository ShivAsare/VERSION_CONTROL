	REGION Cycle 3 - FINAL RINSE CYCLE
	    
	    "DB616".CycleSelection[3].StepSelection.SetRepetition := "DB624"."FinalRinseCycleNo.OfRep";
	    
	    "DB616".FillingInputPara[3].ProductionSetting.ZDVDelay := "CommonProductionSettings".WFIDelay;
	    
	    "DB616".FillingInputPara[3].Parameters.FillQuantity1 := "DB623".FinalRinseCycleFillQty;
	    
	    "DB616".FillingInputPara[3].ProductionSetting.LoopDelay1 := "DB624".FillRinseSamplingLineDelay;
	    "DB616".FillingInputPara[3].ProductionSetting.LoopDelay2 := "DB624".FillRinseBlanketingLineDelay;
