	    "DB616".DrainInputs[3].ProductionSetting.ConductivityCheckTime := "DB624".ConductivityCheckTime;
	    
	    IF "DB609".StepDelay."Noof StepsPv" <= 2 THEN
	        "DB616".DrainInputs[3].Selections.PressureModeSel := 1;
	        "DB616".DrainInputs[3].Selections.DrainPumpSel := 0;
	    ELSE
	        "DB616".DrainInputs[3].Selections.PressureModeSel := 0;
	        "DB616".DrainInputs[3].Selections.DrainPumpSel := 1;
	    END_IF;
	    
	    "DB616".DrainInputs[3].Selections.InputToRunPump := "DiFinal".Cp01FlowSwitch;
	    
	    "DB616".DrainInputs[3].ProductionSetting.LoopDelay1 := "DB624".DrainVesselDrainLineDelay;
	    "DB616".DrainInputs[3].ProductionSetting.LoopDelay2 := "DB624".DrainPumpBypassLineDelay;
	    "DB616".DrainInputs[3].ProductionSetting.LoopDelay3 := "DB624".DrainPf01InLineDelay;
	    "DB616".DrainInputs[3].ProductionSetting.LoopDelay4 := "DB624".DrainPf01VentLineDelay;
	    "DB616".DrainInputs[3].ProductionSetting.LoopDelay5 := "DB624".DrainPf02InLineDelay;
	    "DB616".DrainInputs[3].ProductionSetting.LoopDelay6 := "DB624".DrainPf02VentLineDelay;
	    "DB616".DrainInputs[3].ProductionSetting.LoopDelay7 := "DB624".DrainPf02OutLineDelay;
	    "DB616".DrainInputs[3].ProductionSetting.LoopDelay8 := "DB624".DrainPf01BypassLineDelay;
	    "DB616".DrainInputs[3].ProductionSetting.LoopDelay9 := "DB624".DrainPf02BypassLineDelay;
	    
	    // "DB616".AirPurgingInputPara[2].ProductionSetting.LoopDelay1 := "DB624".AirPurgeSamplingLineDelay;
	    // "DB616".AirPurgingInputPara[2].ProductionSetting.LoopDelay2 := "DB624".AirPurgeBlankeingLineDelay;
	    // "DB616".AirPurgingInputPara[2].ProductionSetting.LoopDelay3 := "DB624".AirPurgeJTubeLineDelay;
	    // "DB616".AirPurgingInputPara[2].ProductionSetting.LoopDelay4 := "DB624".AirPurgeSpargingLineDelay;
	    // "DB616".AirPurgingInputPara[2].ProductionSetting.LoopDelay5 := "DB624".AirPurgeSbiLineDelay;
	    // "DB616".AirPurgingInputPara[2].ProductionSetting.LoopDelay6 := "DB624".AirPurgeVesselDrainLineDelay;
	    
	END_REGION
	REGION FILLING
	    IF "DB615".CurrentStep = 3 THEN
	        "DB616".FillingOutputPara[3] := "DB604".ParaOut;
	        "DB625".FillingPrint[3] := "DB604".Print;
	    ELSE
	        "DB616".FillingOutputPara[3] := "DB616".FillingOutputPara[0];
	    END_IF;
	END_REGION
	
	REGION MIXING
	    IF "DB615".CurrentStep = 3 AND "DB607".CycleEnable = 1 THEN
	        "DB625".MixingTime[3] := "DB607".Print;
	    END_IF;
	END_REGION
	
	REGION RECIRCULATION
	    IF "DB615".CurrentStep = 3 THEN
	        "DB616".RecirculationOutput[3] := "DB608".ParaOut;
	        //"DB625".RecirculationPrint[2] := "DB608".Print;
	    ELSE
	        "DB616".RecirculationOutput[3] := "DB616".RecirculationOutput[0];
	    END_IF;
	END_REGION
	
	REGION DRAIN
	    IF "DB615".CurrentStep = 3 AND "DB609".CycleEnable = 1 THEN
	        "DB616".DrainOutputs[3] := "DB609".ParaOut;
	        
	    ELSE
	        "DB616".DrainOutputs[3] := "DB616".DrainOutputs[0];
	    END_IF;
	END_REGION
	
	REGION SYSTEM DRAIN      
	    IF "DB615".CurrentStep = 3 THEN
	        "DB616".SystemDrainOutPara[3] := "DB610".ParaOut;
	    ELSE
	        "DB616".SystemDrainOutPara[3] := "DB616".SystemDrainOutPara[0];
	    END_IF;
	END_REGION
	
	REGION AIR PURGE
	    IF "DB615".CurrentStep = 3 THEN
	        "DB616".AirPurgingOutPara[3] := "DB611".ParaOut;
	    ELSE
	        "DB616".AirPurgingOutPara[3] := "DB616".AirPurgingOutPara[0];
	    END_IF;
	END_REGION
	REGION ON SCREEN PV
	    IF "DB615".CurrentStep = 3 THEN
	        "DB627".RinseTimeSv := 0;
	        "DB627".RinseTimePv := 0;
	        "DB627".RepSv := "DB623".FillingCycleNoOfRep;
	        "DB627".RepPv := "DB603".ActualRepetition;
	        "DB627".SdSv := "DB623".SystemDrainTime;
	        "DB627".SdPv := "DB610".Timer.TimeSecPV;
	        "DB627".MixingSv := "DB616".MixingTimeInput[3];
	        "DB627".MixingPv := "DB607".MixingTimer.TimeSecPV;
	        //"DB627".FillQtySv :=  "DB616".FillingInputPara[2].Parameters.FillQuantity1;
	        "DB627".FillQtyPv := "ModeDb".VesselWeight;
	        "DB627".ApReleaseTimeSv := "DB624".AirPurgingReleaseTime;
	        "DB627".ApReleaseTimePv := "DB611".ParaOut.Out.PressureReleaseTimePV;
	        "DB627".FillQtySv := "DB623".FinalRinseCycleFillQty;
	        //  "DB627".FillQtyPv := "DB604".ActualQuantity;
	        //"DB627".TempSv := "DB623".Cyc1SetTemp;
	        // "DB627".TempPv := "DB605".ActualTemperature;
	      //  "DB627".APSv := "DB616".AirPurgingOutPara[2].Out.TimeSV;
	        "DB627".ApPv := "DB616".AirPurgingOutPara[3].Out.TimePV;
	        "DB627".APSv := "DB611".ParaOut.Out.TimeSV;
	      //  "DB627".RecirculationSv := "DB616".RecirculationOutput[2].Out.TimeSV;
	        "DB627".RecirculationPv := "DB616".RecirculationOutput[3].Out.TimePV;
	        "DB627".RecirculationSv := "DB608".ParaOut.Out.TimeSV;
	        "DB627".ConductivitySv := "DB609".ParaIn.Parameters.SetConductivity;
	        "DB627".ConductivityPv := "DB609".ActualConductivityVessel;
	        //   "DB627".DosingTimeSv := 0;
	        //   "DB627".DosingTimePv := 0;
	        "DB627".ApSetPressureSv := "DB623".AirPurgingPressure;
	        "DB627".ApSetPressurePv := "DB611".ActualPressure;
	        
	    END_IF;
	END_REGION
	
	
	
	
END_FUNCTION

