	    "DB616".AirPurgingInputPara["DB615".CurrentStep].ProductionSetting.LoopDelay6 := "DB624".AirPurgeRecirculationlineDelay;
	    "DB616".AirPurgingInputPara["DB615".CurrentStep].ProductionSetting.LoopDelay7 := "DB624".AirPurgeVesselBypassLineDelay;
	    "DB616".AirPurgingInputPara["DB615".CurrentStep].ProductionSetting.LoopDelay8 := "DB624".AirPurgeVesselDrainLineDelay;
	    "DB616".AirPurgingInputPara["DB615".CurrentStep].ProductionSetting.LoopDelay9 := "DB624".AirPurgePumpBypassLineDelay;
