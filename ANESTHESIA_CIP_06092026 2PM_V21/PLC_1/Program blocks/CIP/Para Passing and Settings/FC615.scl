	    "DB616".AirPurgingInputPara["DB615".CurrentStep].ProductionSetting.LoopDelay15 := "DB624".AirPurgePf01BypassLineDelay;
	    "DB616".AirPurgingInputPara["DB615".CurrentStep].ProductionSetting.LoopDelay16 := "DB624".AirPurgePf02BypassLineDelay;
	    "DB616".AirPurgingInputPara["DB615".CurrentStep].ProductionSetting.LoopDelay17 := "DB624".AirPurgePtlLineDelay;
	    
	END_REGION
	
	REGION Cycle 1 - PRE RINSE  CYCLE
	    
	    "DB616".CycleSelection[1].StepSelection.SetRepetition := "DB623".PreRinseCycleNoOfRep;
	    
	    "DB616".FillingInputPara[1].ProductionSetting.ZDVDelay := "CommonProductionSettings".WFIDelay;
