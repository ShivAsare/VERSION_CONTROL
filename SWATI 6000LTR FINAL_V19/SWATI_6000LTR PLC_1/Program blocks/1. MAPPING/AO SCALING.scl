FUNCTION "AO SCALING" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1

BEGIN
	
	REGION MFG VESSEL MOTOR SPEED
	    IF "DO MAPING"."MFG VESSEL MOTOR" = FALSE THEN
	        "MFG VESSEL MOTOR SPEED" := 0;
	        "AO SCALING DB".PV."MFG VESSEL MOTOR SPEED" := 0.0;
	    ELSE
	        "@SCALING AO"("ANALOG OUTPUT" := "AO SCALING DB".SET."MFG VESSEL MOTOR SPEED",
	                      "SCALING MIN" := "AO SCALING DB".MIN."MFG VESSEL MOTOR SPEED",
	                      "SCALING MAX" := "AO SCALING DB".MAX."MFG VESSEL MOTOR SPEED",
	                      "RAW MIN" := 0,
	                      "RAW MAX" := 27648,
	                      "PV VALUE" => "MFG VESSEL MOTOR SPEED");
	        "@SCALING AI"("ANALOG INPUT" := "MFG VESSEL MOTOR SPEED",
	                      "RAW MIN" := 0,
	                      "RAW MAX" := 27648,
	                      "SCALE MIN" := "AO SCALING DB".MIN."MFG VESSEL MOTOR SPEED",
	                      "SCALE MAX" := "AO SCALING DB".MAX."MFG VESSEL MOTOR SPEED",
	                      "PV VALUE" => "AO SCALING DB".PV."MFG VESSEL MOTOR SPEED");
	    END_IF;
	    
	    CASE "MODE SELECTION DB"."MODE BUFF" OF
	        1:
	            "AO SCALING DB".SET."MFG VESSEL MOTOR SPEED" :=
	            "SET PARAMETER DB"."AUTO VFD SET PARAMETER"."MFG VESSEL MOTOR SPEED";
	        2:
	            "AO SCALING DB".SET."MFG VESSEL MOTOR SPEED" :=
	            "SET PARAMETER DB"."MANUAL VFD SET PARAMETER"."MFG VESSEL MOTOR SPEED";
	        ELSE
	            "AO SCALING DB".SET."MFG VESSEL MOTOR SPEED" := 0.0;
	    END_CASE;
	END_REGION
	
	REGION PREMIXING VESSEL MOTOR SPEED
	    IF "DO MAPING"."PREMIXING VESSEL MOTOR" = FALSE THEN
	        "PREMIXING VESSEL MOTOR SPEED" := 0;
	        "AO SCALING DB".PV."PREMIXING VESSEL MOTOR SPEED" := 0.0;
	    ELSE
	        "@SCALING AO"("ANALOG OUTPUT" := "AO SCALING DB".SET."PREMIXING VESSEL MOTOR SPEED",
	                      "SCALING MIN" := "AO SCALING DB".MIN."PREMIXING VESSEL MOTOR SPEED",
	                      "SCALING MAX" := "AO SCALING DB".MAX."PREMIXING VESSEL MOTOR SPEED",
	                      "RAW MIN" := 0,
	                      "RAW MAX" := 27648,
	                      "PV VALUE" => "PREMIXING VESSEL MOTOR SPEED");
	        "@SCALING AI"("ANALOG INPUT" := "PREMIXING VESSEL MOTOR SPEED",
	                      "RAW MIN" := 0,
	                      "RAW MAX" := 27648,
	                      "SCALE MIN" := "AO SCALING DB".MIN."PREMIXING VESSEL MOTOR SPEED",
	                      "SCALE MAX" := "AO SCALING DB".MAX."PREMIXING VESSEL MOTOR SPEED",
	                      "PV VALUE" => "AO SCALING DB".PV."PREMIXING VESSEL MOTOR SPEED");
	    END_IF;
	    
	    CASE "MODE SELECTION DB"."MODE BUFF" OF
	        1:
	            "AO SCALING DB".SET."PREMIXING VESSEL MOTOR SPEED" :=
	            "SET PARAMETER DB"."AUTO VFD SET PARAMETER"."PREMIXING VESSEL MOTOR SPEED";
	        2:
	            "AO SCALING DB".SET."PREMIXING VESSEL MOTOR SPEED" :=
	            "SET PARAMETER DB"."MANUAL VFD SET PARAMETER"."PREMIXING VESSEL MOTOR SPEED";
	        ELSE
	            "AO SCALING DB".SET."PREMIXING VESSEL MOTOR SPEED" := 0.0;
	    END_CASE;
	END_REGION
	
	REGION STORAGE VESSEL-1 MOTOR SPEED
	    IF "DO MAPING"."STORAGE VESSEL-1 MOTOR" = FALSE THEN
	        "STORAGE VESSEL-1 MOTOR SPEED" := 0;
	        "AO SCALING DB".PV."STORAGE VESSEL-1 MOTOR SPEED" := 0.0;
	    ELSE
	        "@SCALING AO"("ANALOG OUTPUT" := "AO SCALING DB".SET."STORAGE VESSEL-1 MOTOR SPEED",
	                      "SCALING MIN" := "AO SCALING DB".MIN."STORAGE VESSEL-1 MOTOR SPEED",
	                      "SCALING MAX" := "AO SCALING DB".MAX."STORAGE VESSEL-1 MOTOR SPEED",
	                      "RAW MIN" := 0,
	                      "RAW MAX" := 27648,
	                      "PV VALUE" => "STORAGE VESSEL-1 MOTOR SPEED");
	        "@SCALING AI"("ANALOG INPUT" := "STORAGE VESSEL-1 MOTOR SPEED",
	                      "RAW MIN" := 0,
	                      "RAW MAX" := 27648,
	                      "SCALE MIN" := "AO SCALING DB".MIN."STORAGE VESSEL-1 MOTOR SPEED",
	                      "SCALE MAX" := "AO SCALING DB".MAX."STORAGE VESSEL-1 MOTOR SPEED",
	                      "PV VALUE" => "AO SCALING DB".PV."STORAGE VESSEL-1 MOTOR SPEED");
	    END_IF;
	    
	    CASE "MODE SELECTION DB"."MODE BUFF" OF
