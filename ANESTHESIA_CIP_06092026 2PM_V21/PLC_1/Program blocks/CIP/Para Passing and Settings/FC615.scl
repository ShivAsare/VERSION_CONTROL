	    REGION FILLING
	        IF "DB615".CurrentStep = 1 THEN
	            "DB616".FillingOutputPara[1] := "DB604".ParaOut;
	            "DB625".FillingPrint[1] := "DB604".Print;
	        ELSE
	            "DB616".FillingOutputPara[1] := "DB616".FillingOutputPara[0];
	        END_IF;
	    END_REGION
	    
	    REGION DRAIN
	        IF "DB615".CurrentStep = 1 AND "DB609".CycleEnable = 1 THEN
	            "DB616".DrainOutputs[1] := "DB609".ParaOut;
	
	        ELSE
	            "DB616".DrainOutputs[2] := "DB616".DrainOutputs[0];
	        END_IF;
	    END_REGION
	    
	    REGION SYSTEM DRAIN      
	        IF "DB615".CurrentStep = 1 THEN
	            "DB616".SystemDrainOutPara[1] := "DB610".ParaOut;
	        ELSE
	            "DB616".SystemDrainOutPara[1] := "DB616".SystemDrainOutPara[0];
	        END_IF;
	    END_REGION
	    
	    REGION AIR PURGE
	        IF "DB615".CurrentStep = 1 THEN
	            "DB616".AirPurgingOutPara[1] := "DB611".ParaOut;
	        ELSE
	            "DB616".AirPurgingOutPara[1] := "DB616".AirPurgingOutPara[0];
	        END_IF;
	    END_REGION
	    
	    REGION ON SCREEN PV
	        IF "DB615".CurrentStep = 1 THEN
	            //"DB627".FillQtySv := "DB623".Cyc1FillQty;
	            "DB627".FillQtyPv := "DB604".ActualQuantity;
	            //"DB627".TempSv := "DB623".Cyc1SetTemp;
	           // "DB627".TempPv := "DB605".ActualTemperature;
	            "DB627".MixingPv := "DB607".MixingTimer.TimeSecPV;
	            "DB627".MixingSv := "DB616".MixingTimeInput[1];
	        //    "DB627".APSv := "DB616".AirPurgingOutPara[1].Out.TimeSV;
	            "DB627".ApPv := "DB616".AirPurgingOutPara[1].Out.TimePV;
	            "DB627".APSv := "DB611".ParaOut.Out.TimeSV;
	            "DB627".ApReleaseTimeSv := "DB616".AirPurgingInputPara[1].Parameters.VentOnTime;
	            "DB627".ApReleaseTimePv := "DB616".AirPurgingOutPara[1].Out.PressureReleaseTimePV;
	            "DB627".SdSv := "DB623".SystemDrainTime;
	            "DB627".SdPv := "DB610".TimePv;
	           "DB627".RecirculationSv := "DB616".RecirculationOutput[1].Out.TimeSV;
	           "DB627".RecirculationPv := "DB616".RecirculationOutput[1].Out.TimePV;
	           "DB627".ConductivitySv := "DB609".ParaIn.Parameters.SetConductivity;
	           "DB627".ConductivityPv := "DB609".ActualConductivityVessel;
	         //   "DB627".DosingTimeSv := 0;
	         //   "DB627".DosingTimePv := 0;
	            "DB627".ApSetPressureSv := "DB623".AirPurgingPressure;
	            "DB627".ApSetPressurePv := "DB611".ActualPressure;
	            
	        END_IF;
	    END_REGION
	END_REGION
	
	REGION Cycle 2 - FILLING CYCLE
	    
	    "DB616".CycleSelection[2].StepSelection.SetRepetition := "DB623".FillingCycleNoOfRep;
	    
	    "DB616".FillingInputPara[2].ProductionSetting.ZDVDelay := "CommonProductionSettings".WFIDelay;
	   
	    "DB616".FillingInputPara[2].Parameters.FillQuantity1 := "DB623".FillingCycleFillQty;
	    
	    "DB616".FillingInputPara[2].ProductionSetting.LoopDelay1 := "DB624".FillRinseSamplingLineDelay;
	    "DB616".FillingInputPara[2].ProductionSetting.LoopDelay2 := "DB624".FillRinseBlanketingLineDelay;
	    "DB616".FillingInputPara[2].ProductionSetting.LoopDelay3 := "DB624".FillRinseJTubeLineDelay;
	    "DB616".FillingInputPara[2].ProductionSetting.LoopDelay4 := "DB624".FillRinseSpargingLineDelay;
	    
	    "DB616".MixingTimeInput[2] := "DB623".FillingCycleMixingTime;
	    
	    "DB616".RecirculationInput[2].Parameters.RecirculationInputToRunTime := "Cp01Cmd";
	    
	    "DB616".RecirculationInput[2].Parameters.LoopDelay1 := "DB624".RecSamplingLineDelay;
	    "DB616".RecirculationInput[2].Parameters.LoopDelay2 := "DB624".RecBlanketingLineDelay;
	    "DB616".RecirculationInput[2].Parameters.LoopDelay3 := "DB624".RecJTubeLineDelay;
	    "DB616".RecirculationInput[2].Parameters.LoopDelay4 := "DB624".RecSpargingLineDelay;
	    "DB616".RecirculationInput[2].Parameters.LoopDelay5 := "DB624".RecSbiLineDelay;
	    
	    IF "DB609".StepDelay."Noof StepsPv" <= 2 THEN
	        "DB616".DrainInputs[2].Selections.PressureModeSel := 1;
	        "DB616".DrainInputs[2].Selections.DrainPumpSel := 0;
	    ELSE
	        "DB616".DrainInputs[2].Selections.PressureModeSel := 0;
	        "DB616".DrainInputs[2].Selections.DrainPumpSel := 1;
	    END_IF;
	    
	    "DB616".DrainInputs[2].Selections.InputToRunPump := "DiFinal".Cp01FlowSwitch;
	    
	    "DB616".DrainInputs[2].ProductionSetting.LoopDelay1 := "DB624".DrainVesselDrainLineDelay;
	    "DB616".DrainInputs[2].ProductionSetting.LoopDelay2 := "DB624".DrainPumpBypassLineDelay;
	    "DB616".DrainInputs[2].ProductionSetting.LoopDelay3 := "DB624".DrainPf01InLineDelay;
	    "DB616".DrainInputs[2].ProductionSetting.LoopDelay4 := "DB624".DrainPf01VentLineDelay;
	    "DB616".DrainInputs[2].ProductionSetting.LoopDelay5 := "DB624".DrainPf02InLineDelay;
	    "DB616".DrainInputs[2].ProductionSetting.LoopDelay6 :="DB624".DrainPf02VentLineDelay ;
	    "DB616".DrainInputs[2].ProductionSetting.LoopDelay7 :="DB624".DrainPf02OutLineDelay ;
	    "DB616".DrainInputs[2].ProductionSetting.LoopDelay8 :="DB624".DrainPf01BypassLineDelay ;
	    "DB616".DrainInputs[2].ProductionSetting.LoopDelay9 :="DB624".DrainPf02BypassLineDelay ;
	    
	    // IF "DB611".StepDelay."Noof StepsPv" = 1 THEN
	    //     "DB616".AirPurgingInputPara[2].Selections.PressureMode := 0;
	    // ELSE
	    //     "DB616".AirPurgingInputPara[2].Selections.PressureMode := 1;
	    // END_IF;
	    
	    // "DB616".AirPurgingInputPara[2].ProductionSetting.LoopDelay1 := "DB624".AirPurgeSamplingLineDelay;
	    // "DB616".AirPurgingInputPara[2].ProductionSetting.LoopDelay2 := "DB624".AirPurgeBlankeingLineDelay;
	    // "DB616".AirPurgingInputPara[2].ProductionSetting.LoopDelay3 := "DB624".AirPurgeJTubeLineDelay;
	    // "DB616".AirPurgingInputPara[2].ProductionSetting.LoopDelay4 := "DB624".AirPurgeSpargingLineDelay;
	    // "DB616".AirPurgingInputPara[2].ProductionSetting.LoopDelay5 := "DB624".AirPurgeSbiLineDelay;
	    // "DB616".AirPurgingInputPara[2].ProductionSetting.LoopDelay6 := "DB624".AirPurgeVesselDrainLineDelay;
	    // "DB616".AirPurgingInputPara[2].ProductionSetting.LoopDelay7 := "DB624".AirPurgePumpBypassLineDelay;
	    // "DB616".AirPurgingInputPara[2].ProductionSetting.LoopDelay8 := "DB624".AirPurgePf01InLineDelay;
	    // "DB616".AirPurgingInputPara[2].ProductionSetting.LoopDelay9 := "DB624".AirPurgePf01VentLineDelay;
	    // "DB616".AirPurgingInputPara[2].ProductionSetting.LoopDelay10 := "DB624".AirPurgePf02InLineDelay;
	    // "DB616".AirPurgingInputPara[2].ProductionSetting.LoopDelay11 := "DB624".AirPurgePf02VentLineDelay;
