	    REGION FILLING
	        IF "DB615".CurrentStep = 2 THEN
	            "DB616".FillingOutputPara[2] := "DB604".ParaOut;
	            "DB625".FillingPrint[2] := "DB604".Print;
	        ELSE
	            "DB616".FillingOutputPara[2] := "DB616".FillingOutputPara[0];
	        END_IF;
	    END_REGION
	   
	    REGION MIXING
	        IF "DB615".CurrentStep = 2 AND "DB607".CycleEnable = 1 THEN
	            "DB625".MixingTime[2] := "DB607".Print;
	        END_IF;
