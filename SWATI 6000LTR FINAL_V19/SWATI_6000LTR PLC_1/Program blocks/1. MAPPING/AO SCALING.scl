	            "AO SCALING DB".SET."STORAGE VESSEL-1 MOTOR SPEED" :=
	            "SET PARAMETER DB"."AUTO VFD SET PARAMETER"."STORAGE VESSEL-1 MOTOR SPEED";
	        2:
	            "AO SCALING DB".SET."STORAGE VESSEL-1 MOTOR SPEED" :=
	            "SET PARAMETER DB"."MANUAL VFD SET PARAMETER"."STORAGE VESSEL-1 MOTOR SPEED";
	        ELSE
	            "AO SCALING DB".SET."STORAGE VESSEL-1 MOTOR SPEED" := 0.0;
	    END_CASE;
	END_REGION
	
	REGION STORAGE VESSEL-2 MOTOR SPEED
	    IF "DO MAPING"."STORAGE VESSEL-2 MOTOR" = FALSE THEN
	        "STORAGE VESSEL-2 MOTOR SPEED" := 0;
	        "AO SCALING DB".PV."STORAGE VESSEL-2 MOTOR SPEED" := 0.0;
	    ELSE
	        "@SCALING AO"("ANALOG OUTPUT" := "AO SCALING DB".SET."STORAGE VESSEL-2 MOTOR SPEED",
	                      "SCALING MIN" := "AO SCALING DB".MIN."STORAGE VESSEL-2 MOTOR SPEED",
	                      "SCALING MAX" := "AO SCALING DB".MAX."STORAGE VESSEL-2 MOTOR SPEED",
	                      "RAW MIN" := 0,
	                      "RAW MAX" := 27648,
	                      "PV VALUE" => "STORAGE VESSEL-2 MOTOR SPEED");
	        "@SCALING AI"("ANALOG INPUT" := "STORAGE VESSEL-2 MOTOR SPEED",
	                      "RAW MIN" := 0,
	                      "RAW MAX" := 27648,
	                      "SCALE MIN" := "AO SCALING DB".MIN."STORAGE VESSEL-2 MOTOR SPEED",
	                      "SCALE MAX" := "AO SCALING DB".MAX."STORAGE VESSEL-2 MOTOR SPEED",
	                      "PV VALUE" => "AO SCALING DB".PV."STORAGE VESSEL-2 MOTOR SPEED");
	    END_IF;
	    
	    CASE "MODE SELECTION DB"."MODE BUFF" OF
	        1:
	            "AO SCALING DB".SET."STORAGE VESSEL-2 MOTOR SPEED" :=
	            "SET PARAMETER DB"."AUTO VFD SET PARAMETER"."STORAGE VESSEL-2 MOTOR SPEED";
	        2:
	            "AO SCALING DB".SET."STORAGE VESSEL-2 MOTOR SPEED" :=
	            "SET PARAMETER DB"."MANUAL VFD SET PARAMETER"."STORAGE VESSEL-2 MOTOR SPEED";
	        ELSE
	            "AO SCALING DB".SET."STORAGE VESSEL-2 MOTOR SPEED" := 0.0;
	    END_CASE;
	END_REGION
	
	REGION SUGAR VESSEL MOTOR SPEED
	    IF "DO MAPING"."SUGAR VESSEL MOTOR" = FALSE THEN
	        "SUGAR VESSEL MOTOR SPEED" := 0;
	        "AO SCALING DB".PV."SUGAR VESSEL MOTOR SPEED" := 0.0;
	    ELSE
	        "@SCALING AO"("ANALOG OUTPUT" := "AO SCALING DB".SET."SUGAR VESSEL MOTOR SPEED",
	                      "SCALING MIN" := "AO SCALING DB".MIN."SUGAR VESSEL MOTOR SPEED",
	                      "SCALING MAX" := "AO SCALING DB".MAX."SUGAR VESSEL MOTOR SPEED",
	                      "RAW MIN" := 0,
	                      "RAW MAX" := 27648,
	                      "PV VALUE" => "SUGAR VESSEL MOTOR SPEED");
	        "@SCALING AI"("ANALOG INPUT" := "SUGAR VESSEL MOTOR SPEED",
	                      "RAW MIN" := 0,
	                      "RAW MAX" := 27648,
	                      "SCALE MIN" := "AO SCALING DB".MIN."SUGAR VESSEL MOTOR SPEED",
	                      "SCALE MAX" := "AO SCALING DB".MAX."SUGAR VESSEL MOTOR SPEED",
	                      "PV VALUE" => "AO SCALING DB".PV."SUGAR VESSEL MOTOR SPEED");
	    END_IF;
	    
	    CASE "MODE SELECTION DB"."MODE BUFF" OF
	        1:
	            "AO SCALING DB".SET."SUGAR VESSEL MOTOR SPEED" :=
	            "SET PARAMETER DB"."AUTO VFD SET PARAMETER"."SUGAR VESSEL MOTOR SPEED";
	        2:
	            "AO SCALING DB".SET."SUGAR VESSEL MOTOR SPEED" :=
	            "SET PARAMETER DB"."MANUAL VFD SET PARAMETER"."SUGAR VESSEL MOTOR SPEED";
	        ELSE
	            "AO SCALING DB".SET."SUGAR VESSEL MOTOR SPEED" := 0.0;
	    END_CASE;
	END_REGION
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
END_FUNCTION

