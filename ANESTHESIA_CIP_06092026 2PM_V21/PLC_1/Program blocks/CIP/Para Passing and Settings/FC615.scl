	    // "DB616".AirPurgingInputPara[1].ProductionSetting.LoopDelay17 :="DB624".AirPurgePtlLineDelay ;
	    
	    // CASE "DB611".StepDelay."Noof StepsPv" OF
	    //     0..5:
	    //         "DB616".AirPurgingInputPara[1].Selections.PressureMode := 1;
	    //     6:
	    //         "DB616".AirPurgingInputPara[1].Selections.PressureMode := 0;
